{
  "name": "jan-app",
  "private": true,
  "type": "module",
  "workspaces": {
    "packages": [
      "core",
      "web-app",
      "extensions/*"
    ]
  },
  "scripts": {
    "postinstall": "node ./scripts/patch-esbuild.mjs",
    "lint": "yarn workspace @janhq/web-app lint",
    "dev": "yarn dev:tauri",
    "build": "yarn build:tauri",
    "test": "yarn test:core && yarn test:web && yarn test:ext",
    "test:core": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --project @janhq/core",
    "test:web": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --project @janhq/web-app",
    "test:ext": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --project '@janhq/*-extension'",
    "test:all": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run",
    "test:watch": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest",
    "test:ui": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest --ui",
    "test:coverage": "cross-env NODE_OPTIONS=--max-old-space-size=4096 vitest run --coverage",
    "test:prepare": "yarn build:icon && yarn copy:assets:tauri && yarn build --no-bundle ",
    "dev:web": "yarn workspace @janhq/web-app dev",
    "dev:tauri": "yarn build:icon && yarn copy:assets:tauri && cross-env IS_CLEAN=true tauri dev",
    "copy:assets:tauri": "cpx \"LICENSE\" \"src-tauri/resources/\"",
    "download:lib": "node ./scripts/download-lib.mjs",
    "download:bin": "node ./scripts/download-bin.mjs",
    "build:tauri:win32": "yarn download:bin && yarn tauri build",
    "build:tauri": "yarn build:icon && yarn copy:assets:tauri && yarn build:tauri:win32",
    "build:tauri:plugin:api": "cd src-tauri/plugins && yarn install && cd ../.. && yarn build:tauri:plugin:api:win32",
    "build:tauri:plugin:api:win32": "cd src-tauri/plugins && yarn workspaces foreach -Apt --exclude @janhq/tauri-plugin-mlx-api run build",
    "build:icon": "tauri icon ./src-tauri/icons/icon.png",
    "build:core": "cd core && yarn build && yarn pack",
    "build:web": "yarn workspace @janhq/web-app build",
    "build:extensions": "yarn workspace @janhq/core build && yarn workspaces foreach -Apt --include '@janhq/*-extension' run build",
    "prepare": "husky"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.7.0",
    "@vitest/coverage-v8": "^3.1.3",
    "cpx": "^1.5.0",
    "cross-env": "^7.0.3",
    "husky": "^9.1.5",
    "jsdom": "^26.1.0",
    "rimraf": "^3.0.2",
    "run-script-os": "^1.1.6",
    "tar": "^4.4.19",
    "unzipper": "^0.12.3",
    "vitest": "^3.1.3"
  },
  "version": "0.0.0",
  "installConfig": {
    "hoistingLimits": "workspaces"
  },
  "resolutions": {
    "yallist": "4.0.0",
    "@types/react": "19.1.2",
    "@types/react-dom": "19.1.2"
  },
  "packageManager": "yarn@4.5.3"
}
